# =============================================================================
# BookshelfSystem_-S 環境変数テンプレート
#
# このファイルを .env.local としてコピーし、実際の値を設定してください。
#   cp .env.local.example .env.local
#
# 注意: .env.local は .gitignore 済みです。実際のキーを本ファイルへ
#       直接記述してコミットしないでください。
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
#   取得元: Supabase ダッシュボード > Project Settings > API
# -----------------------------------------------------------------------------
# プロジェクト URL（ブラウザへ露出します）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon キー。RLS によって保護されるためブラウザへ露出して問題ありません
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role キー。RLS を迂回する強力なキーのため、
# サーバーサイド（Route Handler / Server Action）でのみ使用してください。
# NEXT_PUBLIC_ プレフィックスを付けないこと。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# 楽天ブックス書籍検索API
#   取得元: https://webservice.rakuten.co.jp/
# -----------------------------------------------------------------------------
# アプリID（サーバーサイドからのみ使用します）
RAKUTEN_APP_ID=your-rakuten-application-id

# アフィリエイトID（任意。未使用の場合は空のままで構いません）
RAKUTEN_AFFILIATE_ID=

# -----------------------------------------------------------------------------
# アプリケーション
# -----------------------------------------------------------------------------
# 認証コールバックのリダイレクト先に使用します
# 本番環境では Vercel のデプロイ URL を設定してください
NEXT_PUBLIC_SITE_URL=http://localhost:3000
